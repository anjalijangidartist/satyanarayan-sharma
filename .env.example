# Copy to .env.local for local testing. Never commit .env.local.
# On Vercel, add these under Project Settings -> Environment Variables.

# At least 32 random characters. Example: openssl rand -base64 48
SESSION_SECRET=

# Output of: npm run hash-password
PORTAL_PASSWORD_HASH=

# Repository that receives the committed photos.
GITHUB_REPO=owner/repository
GITHUB_BRANCH=main

# Preferred: GitHub App installed only on this repository.
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"

# Alternative to the GitHub App. Fine-grained token with Contents: Read and write.
GITHUB_TOKEN=

# Optional commit identity.
GIT_AUTHOR_NAME=Artwork Portal
GIT_AUTHOR_EMAIL=portal@users.noreply.github.com

# Optional durable login rate limiting across serverless instances.
# Without this, limits are per serverless instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
